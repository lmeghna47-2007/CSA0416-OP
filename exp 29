
#include <stdio.h>

int mutex = 1;
int full = 0;
int empty = 5;
int x = 0;

int wait(int s)
{
    return --s;
}

int signal(int s)
{
    return ++s;
}

void producer()
{
    mutex = wait(mutex);
    empty = wait(empty);
    full = signal(full);

    x++;
    printf("\nProducer produces item %d", x);

    mutex = signal(mutex);
}

void consumer()
{
    mutex = wait(mutex);
    full = wait(full);
    empty = signal(empty);

    printf("\nConsumer consumes item %d", x);
    x--;

    mutex = signal(mutex);
}

int main()
{
    int choice;

    printf("Producer Consumer Problem\n");

    while(1)
    {
        printf("\n\n1. Producer");
        printf("\n2. Consumer");
        printf("\n3. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                if((mutex == 1) && (empty != 0))
                    producer();
                else
                    printf("\nBuffer is full!");
                break;

            case 2:
                if((mutex == 1) && (full != 0))
                    consumer();
                else
                    printf("\nBuffer is empty!");
                break;

            case 3:
                return 0;

            default:
                printf("\nInvalid choice!");
        }
    }
}
