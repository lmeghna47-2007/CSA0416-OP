#include <stdio.h>

struct Employee
{
    int id;
    char name[30];
    float salary;
};

int main()
{
    FILE *fp;
    struct Employee e;
    int choice, record, n;

    fp = fopen("employee.dat", "rb+");

    if (fp == NULL)
        fp = fopen("employee.dat", "wb+");

    if (fp == NULL)
    {
        printf("File cannot be opened.\n");
        return 1;
    }

    while (1)
    {
        printf("\n--- Employee Records ---\n");
        printf("1. Add Employee\n");
        printf("2. Display Employee\n");
        printf("3. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Enter record number (1 onwards): ");
                scanf("%d", &record);

                if (record < 1)
                {
                    printf("Invalid record number.\n");
                    break;
                }

                printf("Enter employee ID: ");
                scanf("%d", &e.id);

                printf("Enter employee name: ");
                scanf("%29s", e.name);

                printf("Enter salary: ");
                scanf("%f", &e.salary);

                fseek(fp, (long)(record - 1) * sizeof(e),
                      SEEK_SET);
                fwrite(&e, sizeof(e), 1, fp);

                printf("Employee record saved.\n");
                break;

            case 2:
                printf("Enter record number to display: ");
                scanf("%d", &record);

                if (record < 1)
                {
                    printf("Invalid record number.\n");
                    break;
                }

                fseek(fp, (long)(record - 1) * sizeof(e),
                      SEEK_SET);

                n = fread(&e, sizeof(e), 1, fp);

                if (n == 1)
                {
                    printf("\nEmployee ID: %d\n", e.id);
                    printf("Employee Name: %s\n", e.name);
                    printf("Salary: %.2f\n", e.salary);
                }
                else
                {
                    printf("Record not found.\n");
                }
                break;

            case 3:
                fclose(fp);
                return 0;

            default:
                printf("Invalid choice.\n");
        }
    }
}
