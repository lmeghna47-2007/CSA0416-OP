#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd1, fd2;
    char buffer[100];
    int n;

    fd1 = open("source.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
    write(fd1, "Hello Operating System", 22);
    close(fd1);

    fd1 = open("source.txt", O_RDONLY);
    fd2 = open("destination.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);

    n = read(fd1, buffer, 100);
    write(fd2, buffer, n);

    close(fd1);
    close(fd2);

    printf("File copied successfully");

    return 0;
}
