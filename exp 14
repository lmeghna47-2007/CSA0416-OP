


#include <stdio.h>
#include <string.h>

int main()
{
    char files[20][30];
    char name[30];
    int n = 0, choice, i, found;

    while (1)
    {
        printf("\n--- Single Level Directory ---\n");
        printf("1. Create a file\n");
        printf("2. Search for a file\n");
        printf("3. Display all files\n");
        printf("4. Delete a file\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                if (n == 20)
                {
                    printf("Directory is full!\n");
                    break;
                }

                printf("Enter file name: ");
                scanf("%29s", name);

                found = 0;
                for (i = 0; i < n; i++)
                {
                    if (strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if (found)
                    printf("File already exists!\n");
                else
                {
                    strcpy(files[n], name);
                    n++;
                    printf("File created successfully.\n");
                }
                break;

            case 2:
                printf("Enter file name to search: ");
                scanf("%29s", name);

                found = 0;
                for (i = 0; i < n; i++)
                {
                    if (strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if (found)
                    printf("File found: %s\n", name);
                else
                    printf("File not found.\n");
                break;

            case 3:
                if (n == 0)
                    printf("Directory is empty.\n");
                else
                {
                    printf("Files in directory:\n");
                    for (i = 0; i < n; i++)
                        printf("%s\n", files[i]);
                }
                break;

            case 4:
                printf("Enter file name to delete: ");
                scanf("%29s", name);

                found = 0;
                for (i = 0; i < n; i++)
                {
                    if (strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        for (int j = i; j < n - 1; j++)
                            strcpy(files[j], files[j + 1]);

                        n--;
                        printf("File deleted successfully.\n");
                        break;
                    }
                }

                if (!found)
                    printf("File not found.\n");
                break;

            case 5:
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }
}
