#include <stdio.h>
#include <string.h>

int main()
{
    char users[10][30];
    char files[10][10][30];
    char uname[30], fname[30];
    int u = 0, n, choice, i, j, found;

    while (1)
    {
        printf("\n--- Two Level Directory ---\n");
        printf("1. Create User\n");
        printf("2. Create File\n");
        printf("3. Search File\n");
        printf("4. Display Files\n");
        printf("5. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                if (u == 10)
                {
                    printf("Maximum users reached!\n");
                    break;
                }

                printf("Enter user name: ");
                scanf("%29s", uname);

                found = 0;
                for (i = 0; i < u; i++)
                    if (strcmp(users[i], uname) == 0)
                        found = 1;

                if (found)
                    printf("User already exists!\n");
                else
                {
                    strcpy(users[u], uname);
                    u++;
                    printf("User directory created.\n");
                }
                break;

            case 2:
                printf("Enter user name: ");
                scanf("%29s", uname);

                for (i = 0; i < u; i++)
                    if (strcmp(users[i], uname) == 0)
                        break;

                if (i == u)
                {
                    printf("User not found!\n");
                    break;
                }

                printf("Enter file name: ");
                scanf("%29s", fname);

                found = 0;
                for (j = 0; j < 10; j++)
                {
                    if (files[i][j][0] == '\0')
                        break;
                    if (strcmp(files[i][j], fname) == 0)
                        found = 1;
                }

                if (found)
                    printf("File already exists!\n");
                else if (j == 10)
                    printf("Directory is full!\n");
                else
                {
                    strcpy(files[i][j], fname);
                    printf("File created successfully.\n");
                }
                break;

            case 3:
                printf("Enter user name: ");
                scanf("%29s", uname);

                for (i = 0; i < u; i++)
                    if (strcmp(users[i], uname) == 0)
                        break;

                if (i == u)
                {
                    printf("User not found!\n");
                    break;
                }

                printf("Enter file name: ");
                scanf("%29s", fname);

                found = 0;
                for (j = 0; j < 10; j++)
                {
                    if (files[i][j][0] == '\0')
                        continue;
                    if (strcmp(files[i][j], fname) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if (found)
                    printf("File found in %s directory.\n", uname);
                else
                    printf("File not found!\n");
                break;

            case 4:
                for (i = 0; i < u; i++)
                {
                    printf("\nUser: %s\n", users[i]);
                    for (j = 0; j < 10; j++)
                        if (files[i][j][0] != '\0')
                            printf("  %s\n", files[i][j]);
                }
                break;

            case 5:
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }
}
