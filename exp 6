
#include <stdio.h>

struct Process {
    int pid;
    int arrival_time;
    int burst_time;
    int remaining_time;
    int priority;
    int completion_time;
    int waiting_time;
    int turnaround_time;
};

int main() {
    struct Process p[100], temp;
    int n, i, time = 0, completed = 0;
    int idx;
    float avg_waiting = 0, avg_turnaround = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid number of processes!\n");
        return 1;
    }

    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;

        printf("\nEnter arrival time, burst time and priority for P%d: ",
               p[i].pid);
        scanf("%d %d %d",
              &p[i].arrival_time,
              &p[i].burst_time,
              &p[i].priority);

        if (p[i].arrival_time < 0 || p[i].burst_time <= 0) {
            printf("Invalid arrival time or burst time!\n");
            return 1;
        }

        p[i].remaining_time = p[i].burst_time;
        p[i].completion_time = 0;
    }

    /* Preemptive priority scheduling */
    while (completed < n) {
        idx = -1;

        /* Select the highest-priority arrived process */
        for (i = 0; i < n; i++) {
            if (p[i].arrival_time <= time &&
                p[i].remaining_time > 0) {

                if (idx == -1 ||
                    p[i].priority < p[idx].priority ||
                    (p[i].priority == p[idx].priority &&
                     p[i].arrival_time < p[idx].arrival_time)) {
                    idx = i;
                }
            }
        }

        if (idx == -1) {
            time++;
            continue;
        }

        /* Execute the selected process for one time unit */
        p[idx].remaining_time--;
        time++;

        /* If process finishes, record completion time */
        if (p[idx].remaining_time == 0) {
            p[idx].completion_time = time;
            completed++;
        }
    }

    /* Calculate turnaround time and waiting time */
    for (i = 0; i < n; i++) {
        p[i].turnaround_time =
            p[i].completion_time - p[i].arrival_time;

        p[i].waiting_time =
            p[i].turnaround_time - p[i].burst_time;

        avg_waiting += p[i].waiting_time;
        avg_turnaround += p[i].turnaround_time;
    }

    avg_waiting /= n;
    avg_turnaround /= n;

    /* Display results */
    printf("\nPID\tAT\tBT\tPriority\tCT\tTAT\tWT\n");

    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].arrival_time,
               p[i].burst_time,
               p[i].priority,
               p[i].completion_time,
               p[i].turnaround_time,
               p[i].waiting_time);
    }

    printf("\nAverage Waiting Time = %.2f\n", avg_waiting);
    printf("Average Turnaround Time = %.2f\n", avg_turnaround);

    return 0;
}
