#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <sys/wait.h>
#include <unistd.h>

struct message {
    long msg_type;
    char msg_text[100];
};

int main() {
    int msgid;
    struct message msg;
    pid_t pid;

    /* Create a message queue */
    msgid = msgget(IPC_PRIVATE, IPC_CREAT | 0666);

    if (msgid == -1) {
        perror("msgget");
        return 1;
    }

    pid = fork();

    if (pid < 0) {
        perror("fork");
        msgctl(msgid, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        /* Child process: send a message */
        msg.msg_type = 1;
        strcpy(msg.msg_text,
               "Hello! Message sent through message queue.");

        if (msgsnd(msgid, &msg,
                   sizeof(msg.msg_text), 0) == -1) {
            perror("msgsnd");
            exit(1);
        }

        printf("Child Process: Message sent successfully.\n");
        exit(0);
    } else {
        /* Parent process: receive the message */
        wait(NULL);

        if (msgrcv(msgid, &msg,
                   sizeof(msg.msg_text), 1, 0) == -1) {
            perror("msgrcv");
            msgctl(msgid, IPC_RMID, NULL);
            return 1;
        }

        printf("Parent Process: Message received:\n");
        printf("%s\n", msg.msg_text);

        /* Remove the message queue */
        if (msgctl(msgid, IPC_RMID, NULL) == -1) {
            perror("msgctl");
            return 1;
        }
    }

    return 0;
}
